{
  "manifest_version": 3,
  "name": "X Provisioning Autofill",
  "version": "0.1.0",
  "description": "Autofills X signup fields with throwaway data + verification codes from the provisioning backend. You drive; it fills.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "X Provisioning Autofill" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
