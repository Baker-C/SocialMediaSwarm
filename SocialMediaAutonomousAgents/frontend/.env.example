# Dev: omit REACT_APP_API_URL to use the dev-server proxy (see src/setupProxy.js).
# Production (server.js): point REACT_APP_PROXY_TARGET at the backend's tailnet URL.
# It is dialed through tailscaled's SOCKS5 proxy, so MagicDNS names work:
# REACT_APP_PROXY_TARGET=http://render-backend:8000
# REACT_APP_API_URL=http://localhost:8000
REACT_APP_POLLING_INTERVAL=5000
REACT_APP_CHART_COLORS=["#8884d8", "#82ca9d", "#ffc658"]
