# Copy to .env — never commit .env
RAVENDB_URL=https://localhost
RAVENDB_DB=SocialMediaSwarm
RAVENDB_VERIFY_SSL=false

# If RavenDB returns 403 InvalidAuth ("requires client certificate"), set PEM paths
# or place files under your home directory: ravendb/certs/ (see below).
# RAVENDB_CLIENT_CERT=C:\path\to\client-cert.pem
# RAVENDB_CLIENT_KEY=C:\path\to\private-key.pem
# Or a single PEM that contains both cert and key — set only RAVENDB_CLIENT_CERT.
#
# Auto-discovery (when both vars are empty): ~/ravendb/certs/client.pem [+ client.key],
# client.crt + client.key, or any *.crt with a matching *.key (e.g. ravendb-*.instance.crt).

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Dashboard login gate (required before exposing the backend publicly via Tailscale Funnel).
# When DASHBOARD_PASSWORD is empty, auth is OFF and all routes are open.
# DASHBOARD_PASSWORD=change-me
# Secret that signs 30-day login tokens; defaults to ENCRYPTION_KEY when empty. Use a long random string.
# DASHBOARD_SESSION_SECRET=
# DASHBOARD_SESSION_DAYS=30
# Browser origins allowed by CORS (comma-separated), e.g. your Vercel site. localhost is always allowed.
# ALLOWED_ORIGINS=https://your-app.vercel.app

SCHEDULER_TIMEZONE=UTC
# Automated posting paused from start hour (inclusive) to end hour (exclusive); manual force posts ignore this
# POST_QUIET_HOURS_ENABLED=true
# POST_QUIET_HOURS_START=0
# POST_QUIET_HOURS_END=8
SCHEDULER_MISFIRE_GRACE_SECONDS=300
# Set false on secondary uvicorn workers so only one process runs :00/:05/:10 jobs
# RUN_SCHEDULER=true
# Set false to pause automatic scheduled posts (forced posts via scripts still work)
# INTERVAL_POSTING_ENABLED=false
# Scheduled posting interval (APScheduler IntervalTrigger)
# POST_INTERVAL_MINUTES=20
# Min minutes between posts per account; keep below POST_INTERVAL_MINUTES
# POST_COOLDOWN_MINUTES=18
# POST_LOCK_TTL_SECONDS=600
# Docker: point at host RavenDB (set in docker-compose.yml, not usually in .env)
# RAVENDB_URL=https://host.docker.internal

# Optional: Anthropic Claude for candidate generation + ranking (Messages API)
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: fal.ai media generation (Seedance video + Seedream image). Tools only; not yet wired.
# FAL_API_KEY=
# FAL_SEEDREAM_IMAGE_MODEL=fal-ai/bytedance/seedream/v3/text-to-image
# FAL_SEEDANCE_T2V_MODEL=fal-ai/bytedance/seedance/v1/pro/text-to-video
# FAL_SEEDANCE_I2V_MODEL=fal-ai/bytedance/seedance/v1/pro/image-to-video
# FAL_DEFAULT_VIDEO_RESOLUTION=1080p
# FAL_DEFAULT_VIDEO_DURATION=5
# FAL_POLL_TIMEOUT_SECONDS=900
# Where generated/imported media bytes are saved on this machine.
# MEDIA_STORE_DIR=media_store
# NOTE: attaching media to X posts also needs "media.write" added to TWITTER_OAUTH2_SCOPES.

# Account provisioning (auto-create fresh X accounts via a local browser agent).
# Shared secret the local agent presents as "Authorization: Bearer <token>".
# PROVISIONING_AGENT_TOKEN=
# PROVISIONING_AGENT_ENABLED=false
# Pay-per-use card handed to the agent only when ALL four fields are set (single
# operator card; PCI risk accepted for throwaway use).
# PROVISIONING_CARD_NUMBER=
# PROVISIONING_CARD_EXP=MM/YY
# PROVISIONING_CARD_CVV=
# PROVISIONING_CARD_NAME=

# Disposable identity (email + phone) for provisioning. Keys live in the backend only.
# Email: an owned domain with Cloudflare Email Routing catch-all is recommended;
# public disposable domains are blocklisted by X. API base is the mailbox read API
# (Cloudflare Worker/KV, IMAP bridge, or mail.tm as a fallback provider).
# DISPOSABLE_EMAIL_DOMAIN=
# DISPOSABLE_EMAIL_API_BASE=
# DISPOSABLE_EMAIL_API_KEY=
# Phone: MUST be a SIM-based OTP-receive provider (5sim SIM tier / TextVerified).
# VoIP/Twilio numbers are rejected by X (2026). Numbers are billed per-use.
# DISPOSABLE_PHONE_API_BASE=
# DISPOSABLE_PHONE_API_KEY=
# DISPOSABLE_PHONE_COUNTRY=

# Optional: live RavenDB + X API health (get_me when OAuth2 user credentials exist on accounts).
# API_HEALTH_CHECK=1
# Legacy alias: TWITTER_API_HEALTH_CHECK=1 (same behavior)

# X / Twitter OAuth 2.0 app (confidential client — do not commit)
# TWITTER_OAUTH2_CLIENT_ID=
# TWITTER_OAUTH2_CLIENT_SECRET=
# Must match the callback URL configured in the X Developer Portal:
# TWITTER_OAUTH2_REDIRECT_URI=http://localhost:8000/api/oauth/x/callback
# Where to send the browser after a successful OAuth callback:
# TWITTER_OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000
# X Developer Portal "Website URL" field (must be https://, not used for redirects):
# TWITTER_OAUTH2_WEBSITE_URL=https://example.com
# TWITTER_OAUTH2_SCOPES=tweet.read tweet.write users.read follows.read offline.access
# OAUTH2_SESSION_TTL_SECONDS=600
# OAUTH2_REFRESH_ENABLED=true
# OAUTH2_REFRESH_INTERVAL_MINUTES=30
# OAUTH2_REFRESH_BATCH_SIZE=200
#
# Per-account tokens are obtained at runtime via GET /api/oauth/x/authorize?account_id=...
# and stored encrypted in the OAuthTokens RavenDB collection (not on account documents).
#
# Trends in interval tick: personalized for the authenticated user first, then WOEID fallback
# TRENDS_PREFER_PERSONALIZED=true
# TRENDS_FALLBACK_WOEID=1

# Print JSON handoffs between interval pipeline steps (console + log)
# TICK_PIPELINE_TRACE=true

# External reference tweets: per-niche X recent search (queries derived from each account's niches)
# FOLLOWING_FEED_ENABLED=true
# TREND_SEARCH_MAX_RESULTS=100
# FOLLOWING_TIMELINE_MAX_RESULTS=100
# REFERENCE_TWEET_CACHE_MINUTES=45
# FOLLOWING_FEED_FILTER_BY_TREND=true

# Legacy Buffer (optional manual scripts only; core app posts via X/Tweepy)
# BUFFER_API_KEY=
# BUFFER_ORGANIZATION_ID=

LOG_LEVEL=INFO
ENVIRONMENT=development
